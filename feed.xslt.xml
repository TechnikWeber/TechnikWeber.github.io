<?xml version="1.0" encoding="utf-8"?>
<!-- Macht aus dem Atom-Feed eine lesbare Seite, wenn ihn jemand im Browser
     oeffnet. Feedreader ignorieren diese Datei und lesen weiter das XML.
     jekyll-feed verlinkt sie automatisch, sobald sie "feed.xslt.xml" heisst
     und im Wurzelverzeichnis liegt. -->
<xsl:stylesheet version="1.0"
                xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
                xmlns:atom="http://www.w3.org/2005/Atom">
  <xsl:output method="html" encoding="utf-8" indent="yes"/>

  <xsl:template match="/atom:feed">
    <html lang="de">
      <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <title><xsl:value-of select="atom:title"/> · Feed</title>
        <style>
          body {
            font: 16px/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI",
                  Roboto, Helvetica, Arial, sans-serif;
            color: #111;
            background: #fdfdfd;
            max-width: 700px;
            margin: 0 auto;
            padding: 2em 1em 4em;
          }
          a { color: #2a7ae2; text-decoration: none; }
          a:hover { text-decoration: underline; }
          h1 { font-size: 1.7em; margin: 0 0 .2em; }
          .sub { color: #828282; margin: 0 0 2em; }
          .hinweis {
            background: #f4f6f8;
            border-left: 4px solid #2a7ae2;
            border-radius: 0 4px 4px 0;
            padding: .9em 1.1em;
            margin-bottom: 2.5em;
            font-size: .94em;
          }
          .hinweis p { margin: 0 0 .6em; }
          .hinweis p:last-child { margin-bottom: 0; }
          code {
            background: #eef0f2;
            padding: .1em .35em;
            border-radius: 3px;
            font-size: .9em;
            word-break: break-all;
          }
          article {
            padding-top: 1.4em;
            margin-top: 1.4em;
            border-top: 1px solid #e8e8e8;
          }
          article h2 { font-size: 1.15em; margin: 0 0 .15em; }
          time { color: #828282; font-size: .88em; }
          .text { color: #444; margin: .5em 0 0; }
        </style>
      </head>
      <body>
        <h1><xsl:value-of select="atom:title"/></h1>
        <p class="sub"><xsl:value-of select="atom:subtitle"/></p>

        <div class="hinweis">
          <p><strong>Das hier ist der RSS-Feed dieses Blogs</strong> – eine
          Liste der Beiträge zum Abonnieren.</p>
          <p>Diese Adresse in einen Feedreader eintragen, dann melden sich
          neue Beiträge dort von selbst, ganz ohne Konto und ohne Newsletter:
          <code>https://technikweber.github.io/feed.xml</code></p>
        </div>

        <xsl:for-each select="atom:entry">
          <article>
            <h2>
              <a target="_blank">
                <xsl:attribute name="href">
                  <xsl:value-of select="atom:link/@href"/>
                </xsl:attribute>
                <xsl:value-of select="atom:title"/>
              </a>
            </h2>
            <time>
              <xsl:value-of select="substring(atom:published, 9, 2)"/>.<xsl:value-of select="substring(atom:published, 6, 2)"/>.<xsl:value-of select="substring(atom:published, 1, 4)"/>
            </time>
            <xsl:if test="atom:summary">
              <p class="text"><xsl:value-of select="atom:summary"/></p>
            </xsl:if>
          </article>
        </xsl:for-each>
      </body>
    </html>
  </xsl:template>
</xsl:stylesheet>
